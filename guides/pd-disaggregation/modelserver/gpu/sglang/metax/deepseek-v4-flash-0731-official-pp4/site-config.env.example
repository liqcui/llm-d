# ═══════════════════════════════════════════════════════════════════
# 站点配置（部署前: cp site-config.env.example site-config.env 并按实际填写）
# render_site.py 读取本文件, 将 lws/ 下所有 {{占位符}} 渲染为真实值
# ⚠ site-config.env 与 _rendered/ 已加入 .gitignore, 不进入仓库
# ═══════════════════════════════════════════════════════════════════
# role 节点 IP (pernode: prefill ×4 / decode ×4; 旧形态仅用第 0 项)
IP_PREFILL_0=192.0.2.29
IP_PREFILL_1=192.0.2.31
IP_PREFILL_2=192.0.2.36
IP_PREFILL_3=192.0.2.28
IP_DECODE_0=192.0.2.35
IP_DECODE_1=192.0.2.34
IP_DECODE_2=192.0.2.33
IP_DECODE_3=192.0.2.32
# 网段前缀 (env 元数据用)
CLUSTER_SUBNET=192.0.2
# 历史错误样例中的旧集群 IP (仅注释引用, 可忽略)
IP_LEGACY_SAMPLE=192.0.2.232
